FROM E:\本地ai\downloads\Qwen3.6-35B-A3B-Uncensored-IQ2_M.gguf

# ============================================================
# 第二套模型：Qwen3.6-35B-A3B（无审查 / abliteration）
#   为什么加这一份：用户要"更智能"，而 9B 之上的下一档只有它跑得动。
#   MoE：总参 35B，**每个 token 只激活约 3B** —— 所以溢出到内存的部分
#   只有激活的专家要被读，速度比同体积 dense 模型好得多。
#
#   实测依据（2026-09-29，本机）：
#     9B 全上显存      33.5 tok/s → 350 字回复约 10 秒
#     一半层走内存     13.6 tok/s → 约 26 秒
#     大部分走内存      7.9 tok/s → 约 44 秒
#   本模型 IQ2_M = 10.86 GB，本机池子约 15.5 GB（6.4 显存 + 9.1 内存），
#   预计落在 26~35 秒/条。用户已确认可接受。
#
#   ⚠️ 与 xiaojiu9b（9B）并存，**不覆盖**，双击 切换人格.bat 那种方式
#      切换不了模型 —— 换模型要改 astrbot_setup.py 里的 MODEL_ID，
#      或直接在 WebUI 的模型列表里选。老模型仍在，随时可换回。
# ============================================================

# ---- 采样参数（Ollama 官方 huihui_ai/qwen3.5-abliterated:35b 的推荐值）----
# ⚠️ 这三个和 9B 那份**不一样**（9B 是 0.7 / 20 / 0.8）——
#    Qwen3.5 系列的官方非思考档就是 1.0 / 20 / 0.95，照抄 9B 的会跑偏。
PARAMETER temperature 1
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0

# 重复惩罚：沿用 9B 那份的结论（见 Modelfile.assistant-9b 的注释）
PARAMETER repeat_penalty 1.15
PARAMETER repeat_last_n 1024

# 生成上限：768 tok ≈ 650 汉字。
# ⚠️ 2026-09-29 实测（见 交付包\给AI看的\参考-模型对比实测.md）：**35B 经常撞这个上限**——
#    12 个样本里 6 个停在半句（"我的嘴唇没有用力"后面没了）。
#    它比 9B 更容易超，因为它的细节写得满。
#    → 抬到 1024（≈ 870 汉字），代价是长回复多花几秒（约 +7 s @ 38 tok/s）。
#    ⚠️ 改这个值必须重新 `ollama create`，否则不生效（它是建模型时固化的参数）。
PARAMETER num_predict 1024

# 上下文：**2026-10-03 从 32768 提到 40960**（用户要求 C：加长上下文）。
#   为什么加：实测三次会话都在 16.5~18.5K token 时回复明显变短，而 18.5K 只占
#   当时窗口的 59% —— 多留一倍历史能减少"整轮被裁掉导致接不上"。**注意：加窗口
#   只解决"历史被裁"，真正治"越写越短"的是人格里的长度指标（A 那半）。**
#   ⚠️ 内存账（本机实测，别忘）：模型 12 GB，**KV cache 在内存里**（50/50 CPU/GPU），
#      改这次时系统可用内存只剩 1.3 GB / 15.7 GB。32K→40K 大约多占几百 MB，
#      装不下就把这里退回 32768（或 36864）。
#   ⚠️ 改了必须重新 `ollama create`（建模型时固化），且要同步
#      `astrbot_setup.py` 顶部 MODELS 表里的 num_ctx —— 对不上会被 `--check` 判红。
PARAMETER num_ctx 65536

SYSTEM """/no_think"""
